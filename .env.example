# --- API project (Vercel) --------------------------------------------------
# Server-only. Get one from: Discord Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Optional but recommended: deduplicate submissions per wallet AND per X handle.
# Create a free Redis at https://upstash.com (or via Vercel → Storage → Marketplace → Upstash Redis).
# When unset, dedup is skipped and the same wallet can submit multiple times.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Cross-origin allowance for the API. Set this to the exact origin of the
# static frontend on cPanel (e.g. https://yourdomain.com). Leave as "*" only
# while testing — production should pin a specific origin.
CORS_ORIGIN=*

# --- Static frontend (cPanel) ----------------------------------------------
# Public origin of the Vercel-hosted API. Required only for the static build
# (npm run build:static). Without trailing slash. Example:
#   NEXT_PUBLIC_API_BASE_URL=https://raffel-api.vercel.app
NEXT_PUBLIC_API_BASE_URL=
